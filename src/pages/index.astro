---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Portfolio from '../components/Portfolio';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const posts = await getCollection('blog');
const postCount = posts.length;
const latestPosts = posts
  .slice()
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
  .slice(0, 3)
  .map((post) => ({
    title: post.data.title,
    date: post.data.date,
    excerpt: post.data.excerpt || '',
    slug: post.id,
  }));

const codingSince = 2019;
const yearsCoding = new Date().getFullYear() - codingSince;

// Real per-month publish trend over last 12 months for the Posts sparkline.
const now = new Date();
const buckets: number[] = Array(12).fill(0);
for (const post of posts) {
  const d = new Date(post.data.date);
  if (Number.isNaN(d.getTime())) continue;
  const monthsAgo = (now.getFullYear() - d.getFullYear()) * 12 + (now.getMonth() - d.getMonth());
  if (monthsAgo >= 0 && monthsAgo < 12) {
    buckets[11 - monthsAgo] += 1;
  }
}
const postsTrend = buckets;

let publicRepos: number | null = null;
let githubFollowers: number | null = null;
try {
  const res = await fetch('https://api.github.com/users/Salah-XD', {
    headers: { 'User-Agent': 'salahxd-portfolio-build' },
  });
  if (res.ok) {
    const data = (await res.json()) as { public_repos?: number; followers?: number };
    publicRepos = typeof data.public_repos === 'number' ? data.public_repos : null;
    githubFollowers = typeof data.followers === 'number' ? data.followers : null;
  }
} catch {
  /* offline build, fall through */
}

const buildTime = new Date().toISOString();
declare const __BUILD_COMMIT__: string;
const commitSha = __BUILD_COMMIT__;

// Pull /now singleton for the home StatusPanel.
const reader = createReader(process.cwd(), keystaticConfig);
const nowData = await reader.singletons.now.read();
const nowLastUpdated = nowData?.lastUpdated ?? new Date().toISOString().slice(0, 10);
const nowDaysAgo = Math.max(
  0,
  Math.floor((Date.now() - new Date(nowLastUpdated).getTime()) / 86_400_000)
);
const status = {
  mood: nowData?.mood ?? '—',
  focus: nowData?.focus?.[0] ?? '—',
  learning: nowData?.learning?.[0] ?? '—',
  daysAgo: nowDaysAgo,
};
---

<Layout
  title="Mohd Salahudeen - software engineer & founder of QSat & ShineUp"
  description="Mohd Salahudeen (salahxd) — software engineer and founder of QSat and ShineUp. I build software, GIS platforms, and student satellites — writing the code and running the companies."
>
  <Portfolio
    client:load
    stats={{ postCount, publicRepos, githubFollowers, yearsCoding, buildTime, commitSha, postsTrend }}
    latestPosts={latestPosts}
    status={status}
  />
</Layout>
