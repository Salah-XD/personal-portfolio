---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { ArrowLeft } from 'lucide-react';

const staticRoutes = ['/', '/about', '/now', '/uses', '/blog', '/rss.xml'];
const posts = await getCollection('blog');
const blogRoutes = posts.map((p) => `/blog/${p.id}`);
const allRoutes = [...staticRoutes, ...blogRoutes];
---

<Layout
  title="404 | MD Salah"
  description="Command not found."
  ogType="website"
  noindex
>
  <div class="min-h-screen transition-colors duration-300 flex flex-col">
    <main class="flex-1 max-w-3xl mx-auto px-4 py-16 sm:py-24 w-full font-mono">
      <p class="text-sm mb-4 text-slate-600 dark:text-emerald-400">salah@portfolio:~$ <span id="not-found-cmd">cd /lost</span></p>
      <h1 class="text-3xl sm:text-4xl mb-2 leading-tight" data-cmd-line>
        bash: <span id="bad-path">unknown</span>: command not found
      </h1>
      <p class="text-slate-600 dark:text-slate-300 text-sm mb-10">
        The path you tried doesn't exist on this server.
      </p>

      <div class="text-sm mb-3 text-slate-600 dark:text-emerald-400">
        # did you mean...
      </div>
      <ul id="suggestions" class="space-y-2 mb-10">
        <li class="text-slate-500 dark:text-slate-400 italic">computing suggestions…</li>
      </ul>

      <a
        href="/"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-slate-200 dark:border-slate-700 hover:border-slate-300 dark:hover:border-slate-600 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors text-sm"
      >
        <ArrowLeft className="w-4 h-4" />
        <span>cd ~</span>
      </a>
    </main>

    <footer class="border-t border-slate-200 dark:border-slate-700 py-6">
      <div class="max-w-4xl mx-auto px-4">
        <p class="font-mono text-xs sm:text-sm text-slate-500 dark:text-emerald-400 break-words">
          salah@portfolio:~$ exit 127
        </p>
      </div>
    </footer>
  </div>

  <script is:inline define:vars={{ allRoutes }}>
    function distance(a, b) {
      const m = a.length;
      const n = b.length;
      if (!m) return n;
      if (!n) return m;
      const row = new Array(n + 1);
      for (let j = 0; j <= n; j++) row[j] = j;
      for (let i = 1; i <= m; i++) {
        let prev = row[0];
        row[0] = i;
        for (let j = 1; j <= n; j++) {
          const tmp = row[j];
          row[j] = a[i - 1] === b[j - 1]
            ? prev
            : 1 + Math.min(prev, row[j - 1], row[j]);
          prev = tmp;
        }
      }
      return row[n];
    }

    const path = window.location.pathname || '/';
    const badEl = document.getElementById('bad-path');
    if (badEl) badEl.textContent = path;
    const cmdEl = document.getElementById('not-found-cmd');
    if (cmdEl) cmdEl.textContent = `cd ${path}`;

    const ranked = allRoutes
      .map((r) => ({ r, d: distance(path.toLowerCase(), r.toLowerCase()) }))
      .sort((a, b) => a.d - b.d)
      .slice(0, 3);

    const list = document.getElementById('suggestions');
    if (list) {
      list.innerHTML = '';
      ranked.forEach(({ r }) => {
        const li = document.createElement('li');
        li.className = 'flex items-center gap-3';
        const arrow = document.createElement('span');
        arrow.className = 'text-slate-400 dark:text-slate-500';
        arrow.textContent = '›';
        const a = document.createElement('a');
        a.href = r;
        a.textContent = r;
        a.className = 'text-slate-700 dark:text-slate-200 underline underline-offset-2 decoration-slate-300 dark:decoration-emerald-500/50 hover:decoration-slate-700 dark:hover:decoration-emerald-300';
        li.appendChild(arrow);
        li.appendChild(a);
        list.appendChild(li);
      });
    }
  </script>
</Layout>
