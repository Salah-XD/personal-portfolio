---
import Layout from '../layouts/Layout.astro';
import { ArrowLeft } from 'lucide-react';
import ThemeToggle from '../components/ThemeToggle';
import SearchPalette from '../components/SearchPalette';
import SfxToggle from '../components/SfxToggle';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const data = await reader.singletons.uses.read();
const sections = data?.sections ?? [];
---

<Layout
  title="Uses | MD Salah"
  description="Tools, hardware, and services that I use daily."
  ogType="website"
>
  <div class="min-h-screen transition-colors duration-300">
    <header class="border-b border-slate-200 dark:border-slate-700">
      <div class="max-w-4xl mx-auto px-4 py-6 flex items-center justify-between gap-3">
        <a href="/" class="flex items-center space-x-2 font-mono text-sm hover:text-slate-700 dark:hover:text-emerald-400 transition-colors">
          <ArrowLeft className="w-4 h-4" />
          <span>cd ..</span>
        </a>
        <div class="flex items-center gap-2">
          <SearchPalette client:load />
          <SfxToggle client:load />
          <ThemeToggle client:load />
        </div>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-12 space-y-10">
      <section>
        <div class="font-mono text-sm mb-6 text-slate-600 dark:text-emerald-400">
          salah@portfolio:~$ apt list --installed | grep favorite
        </div>
        <h1 class="font-mono text-3xl sm:text-4xl mb-2 leading-tight">/uses</h1>
        <p class="font-mono text-sm text-slate-600 dark:text-slate-300">
          The hardware, software, and services I actually use.
        </p>
      </section>

      {sections.map((section) => (
        <section>
          <div class="font-mono text-sm mb-4 text-slate-600 dark:text-emerald-400">
            $ {section.prompt}
          </div>
          <h2 class="font-mono text-xl mb-3">{section.heading}</h2>
          <ul class="space-y-2 font-mono text-sm sm:text-base">
            {section.items.map((item) => (
              <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <span class="text-slate-500 dark:text-slate-400 select-none shrink-0">›</span>
                {item.url ? (
                  <a href={item.url} target="_blank" rel="noreferrer" class="text-slate-700 dark:text-slate-200 underline underline-offset-2 decoration-slate-300 dark:decoration-emerald-500/50 hover:decoration-slate-700 dark:hover:decoration-emerald-300">
                    {item.name}
                  </a>
                ) : (
                  <span class="text-slate-700 dark:text-slate-200">{item.name}</span>
                )}
                {item.detail && (
                  <span class="text-slate-500 dark:text-slate-400 text-sm">— {item.detail}</span>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}

      <section class="pt-4 border-t border-slate-200 dark:border-slate-800">
        <p class="font-mono text-xs text-slate-600 dark:text-slate-400">
          inspired by <a class="underline underline-offset-2" href="https://uses.tech" target="_blank" rel="noreferrer">uses.tech</a> · edit via <a class="underline underline-offset-2" href="/keystatic">/keystatic</a>
        </p>
      </section>
    </main>

    <footer class="border-t border-slate-200 dark:border-slate-700 py-8 mt-12">
      <div class="max-w-4xl mx-auto px-4">
        <p class="font-mono text-xs sm:text-sm text-slate-500 dark:text-emerald-400 break-words">
          salah@portfolio:~$ exit
        </p>
      </div>
    </footer>
  </div>
</Layout>
