---
import Layout from '../layouts/Layout.astro';
import { ArrowLeft, ExternalLink, Instagram, Play, Newspaper } from 'lucide-react';
import ThemeToggle from '../components/ThemeToggle';
import SearchPalette from '../components/SearchPalette';
import SfxToggle from '../components/SfxToggle';
import { qsat } from '../config/portfolio';

// Launch videos. PARKSAT 25 is the confirmed ParkSat launch video.
const videos = [
  { id: 'nYaIimGE-0g', title: 'PARKSAT 25 — Launch' },
];

// Featured local media coverage (image-based — Simplicity, Coimbatore).
// Set `url` once the Simplicity article/post link is available, and it becomes clickable.
const featuredCoverage = {
  outlet: 'Simplicity · Coimbatore',
  caption: 'ParkSat launch — local media coverage',
  image: '/qsat/simplicitycoimbatore_1761830048_3754825053323311603_3985389509.jpg',
  url: null as string | null,
};

// News/media ARTICLE links. Add { outlet, title, url, date } — they render as cards.
const coverage: { outlet: string; title: string; url: string; date?: string }[] = [
];

// Instagram posts & reels (@qsat.diy + coverage) — native embeds via embed.js.
const posts = [
  { url: 'https://www.instagram.com/reel/DQcRnwnElRT/', caption: 'Media coverage (Tamil) — ParkSat launch' },
  { url: 'https://www.instagram.com/p/DRO-9VRkhH3/', caption: 'ParkSat — launch carousel' },
  { url: 'https://www.instagram.com/p/DOtMXjAkoHJ/', caption: 'QSat brand & product at the Rotary RYLA stall' },
  { url: 'https://www.instagram.com/p/DLlAQWxz-WP/', caption: 'First QSat Lab Kit launch — RYLA Starter Stars' },
];
---

<Layout
  title="Press | QSat & ParkSat"
  description="QSat & ParkSat in the media — the ParkSat student-satellite launch and coverage."
  ogType="website"
>
  <div class="min-h-screen transition-colors duration-300">
    <header class="border-b border-slate-200 dark:border-slate-700">
      <div class="max-w-4xl mx-auto px-4 py-6 flex items-center justify-between gap-3">
        <a
          href="/"
          class="flex items-center space-x-2 font-mono text-sm hover:text-slate-700 dark:hover:text-emerald-400 transition-colors"
        >
          <ArrowLeft className="w-4 h-4" />
          <span>cd ..</span>
        </a>
        <div class="flex items-center gap-2">
          <SearchPalette client:load />
          <SfxToggle client:load />
          <ThemeToggle client:load />
        </div>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-12 space-y-12">
      <!-- Intro -->
      <section>
        <div class="font-mono text-sm mb-4 text-slate-600 dark:text-emerald-400">
          salahxd@dev:~/press$ cat press.md
        </div>
        <h1 class="font-mono text-3xl sm:text-4xl mb-4 leading-tight">QSat &amp; ParkSat in the media</h1>
        <p class="text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed">
          Coverage of <a href={qsat.url} target="_blank" rel="noreferrer" class="underline decoration-dotted underline-offset-4 hover:text-slate-900 dark:hover:text-emerald-400">QSat</a>
          and the <strong>ParkSat</strong> student-satellite program — built with Park College of Engineering &amp; Technology and
          inaugurated by ISRO scientist &amp; Padma Bhushan awardee Nambi Narayanan.
        </p>
      </section>

      <!-- Watch -->
      <section>
        <div class="font-mono text-sm mb-6 text-slate-600 dark:text-emerald-400 flex items-center gap-2">
          <Play className="w-4 h-4" />
          salahxd@dev:~/press$ ./watch
        </div>
        <div class="space-y-6">
          {videos.map((v) => (
            <figure>
              <div
                class="relative w-full overflow-hidden rounded-lg border border-slate-200 dark:border-slate-700"
                style="aspect-ratio: 16 / 9;"
              >
                <iframe
                  class="absolute inset-0 w-full h-full"
                  src={`https://www.youtube-nocookie.com/embed/${v.id}`}
                  title={v.title}
                  loading="lazy"
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen
                ></iframe>
              </div>
              <figcaption class="font-mono text-sm mt-2 text-slate-500 dark:text-slate-400">{v.title}</figcaption>
            </figure>
          ))}
        </div>
      </section>

      <!-- Coverage (featured local media first) -->
      <section>
        <div class="font-mono text-sm mb-6 text-slate-600 dark:text-emerald-400 flex items-center gap-2">
          <Newspaper className="w-4 h-4" />
          salahxd@dev:~/press$ cat coverage.md
        </div>

        <figure class="mb-8 max-w-xl overflow-hidden rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/40">
          {featuredCoverage.url ? (
            <a href={featuredCoverage.url} target="_blank" rel="noreferrer" class="block">
              <img src={featuredCoverage.image} alt={`${featuredCoverage.outlet} — ParkSat coverage`} loading="lazy" class="w-full h-auto" />
            </a>
          ) : (
            <img src={featuredCoverage.image} alt={`${featuredCoverage.outlet} — ParkSat coverage`} loading="lazy" class="w-full h-auto" />
          )}
          <figcaption class="px-4 py-3 font-mono text-xs flex flex-wrap items-center gap-x-2 gap-y-1 border-t border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400">
            <span class="text-slate-700 dark:text-emerald-400">{featuredCoverage.outlet}</span>
            <span aria-hidden="true">—</span>
            <span>{featuredCoverage.caption}</span>
          </figcaption>
        </figure>

        {coverage.length > 0 && (
          <div class="grid sm:grid-cols-2 gap-4">
            {coverage.map((c) => (
              <a
                href={c.url}
                target="_blank"
                rel="noreferrer"
                class="block p-5 border rounded-lg border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/50 hover:border-slate-300 dark:hover:border-slate-600 transition-colors"
              >
                <div class="flex items-center justify-between gap-3 mb-2 font-mono text-xs text-slate-500 dark:text-emerald-400">
                  <span>{c.outlet}</span>
                  {c.date && <span>{c.date}</span>}
                </div>
                <p class="text-slate-700 dark:text-slate-200 mb-3 leading-snug">{c.title}</p>
                <span class="inline-flex items-center gap-1 font-mono text-xs text-slate-500 dark:text-slate-400">
                  read <ExternalLink className="w-3 h-3" />
                </span>
              </a>
            ))}
          </div>
        )}
      </section>

      <!-- Posts -->
      <section>
        <div class="font-mono text-sm mb-6 text-slate-600 dark:text-emerald-400 flex items-center gap-2">
          <Instagram className="w-4 h-4" />
          salahxd@dev:~/press$ cat posts.json
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {posts.map((p) => (
            <figure class="min-w-0 flex flex-col">
              <div class="overflow-hidden rounded-xl p-1 border border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-800">
                <blockquote
                  class="instagram-media"
                  data-instgrm-permalink={`${p.url}?utm_source=ig_embed&utm_campaign=loading`}
                  data-instgrm-version="14"
                  style="background:#FFF; border:0; border-radius:10px; margin:0; max-width:100%; min-width:0; width:100%; padding:0;"
                >
                  <a href={p.url} target="_blank" rel="noreferrer">View this post on Instagram</a>
                </blockquote>
              </div>
              <figcaption class="font-mono text-sm mt-2 text-slate-500 dark:text-slate-400">{p.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    </main>

    <footer class="border-t border-slate-200 dark:border-slate-700 py-8 mt-12">
      <div class="max-w-4xl mx-auto px-4">
        <p class="font-mono text-xs sm:text-sm text-slate-500 dark:text-emerald-400 break-words">
          salahxd@dev:~/press$ exit
        </p>
      </div>
    </footer>
  </div>

  <style is:global>
    /* Instagram's rendered iframe carries an inline min-width:326px which overflows
       and blocks 2-up grid cells. Let it shrink to fit its container instead. */
    .instagram-media,
    .instagram-media-rendered {
      min-width: 0 !important;
    }
  </style>

  <!-- Instagram embed renderer (full page loads only; no ClientRouter in use) -->
  <script is:inline async src="https://www.instagram.com/embed.js"></script>
</Layout>
