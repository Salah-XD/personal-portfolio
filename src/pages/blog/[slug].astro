---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { ArrowLeft, Calendar, Clock, Tag } from 'lucide-react';
import ThemeToggle from '../../components/ThemeToggle';
import SearchPalette from '../../components/SearchPalette';
import ReadingProgress from '../../components/ReadingProgress';
import TableOfContents from '../../components/TableOfContents';
import PostEngagement from '../../components/PostEngagement';
import Comments from '../../components/Comments';
import NewsletterForm from '../../components/NewsletterForm';
import ProductCTA from '../../components/ProductCTA.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const ogImage = `/og/${post.id}.png`;
const description = post.data.excerpt || `${post.data.title} — by ${post.data.author}`;
const canonical = new URL(`/blog/${post.id}/`, Astro.site ?? 'https://salahxd.dev').toString();

const giscusRepo = import.meta.env.PUBLIC_GISCUS_REPO;
const giscusRepoId = import.meta.env.PUBLIC_GISCUS_REPO_ID;
const giscusCategory = import.meta.env.PUBLIC_GISCUS_CATEGORY;
const giscusCategoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID;
const giscusReady = giscusRepo && giscusRepoId && giscusCategory && giscusCategoryId;
---

<Layout
  title={`${post.data.title} | Mohd Salahudeen`}
  description={description}
  ogImage={ogImage}
  ogType="article"
  publishedTime={post.data.date}
  author={post.data.author}
  tags={post.data.tags}
>
  <ReadingProgress client:load />

  <div class="min-h-screen transition-colors duration-300">
    <header
      data-nav-sticky
      class="sticky top-0 z-50 backdrop-blur-md bg-slate-50/80 dark:bg-slate-900/80 border-b border-slate-200 dark:border-slate-700 transition-transform duration-300 will-change-transform"
    >
      <div class="max-w-6xl mx-auto px-4 py-6 flex items-center justify-between gap-3">
        <a
          href="/blog"
          class="flex items-center space-x-2 font-mono text-sm hover:text-slate-700 dark:hover:text-emerald-400 transition-colors"
        >
          <ArrowLeft className="w-4 h-4" />
          <span>Back to Blog</span>
        </a>
        <div class="flex items-center gap-2">
          <SearchPalette client:load />
          <ThemeToggle client:load />
        </div>
      </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 py-12 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_220px] gap-12">
      <article class="min-w-0">
        <header class="mb-12">
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-6">
            <div class="flex items-center space-x-2">
              <Calendar className="w-4 h-4 text-slate-500 dark:text-emerald-400" />
              <time class="font-mono text-sm text-slate-500 dark:text-emerald-400">
                {post.data.date}
              </time>
            </div>

            {post.data.readTime && (
              <div class="flex items-center space-x-2">
                <Clock className="w-4 h-4 text-slate-500 dark:text-slate-400" />
                <span class="font-mono text-sm text-slate-500 dark:text-slate-400">
                  {post.data.readTime}
                </span>
              </div>
            )}

            <span class="font-mono text-xs px-2 py-1 rounded bg-slate-100 text-slate-700 dark:bg-slate-700 dark:text-slate-300">
              {post.data.category}
            </span>
          </div>

          <h1 class="font-mono text-2xl sm:text-3xl md:text-4xl lg:text-5xl mb-6 leading-tight break-words">
            {post.data.title}
          </h1>

          {post.data.tags.length > 0 && (
            <div class="flex items-center space-x-2">
              <Tag className="w-4 h-4 text-slate-500 dark:text-slate-400 shrink-0" />
              <div class="flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <span class="font-mono text-xs px-2 py-1 rounded bg-slate-100 text-slate-700 dark:bg-slate-700 dark:text-slate-300">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          )}
        </header>

        <div
          class="prose prose-slate dark:prose-invert max-w-none prose-a:text-slate-700 dark:prose-a:text-emerald-400 hover:prose-a:text-slate-900 dark:hover:prose-a:text-emerald-300"
          data-pagefind-body
        >
          <Content />
        </div>

        <PostEngagement client:load slug={post.id} title={post.data.title} url={canonical} />

        <ProductCTA />

        <div class="mt-12">
          <NewsletterForm client:visible variant="card" source={`post:${post.id}`} title="Liked this? Get the next one in your inbox." description="Short notes on tech and product, every week or two." />
        </div>

        <div class="mt-12 p-6 border rounded-lg border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/50">
          <div class="flex items-start gap-4">
            <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full flex items-center justify-center font-mono text-lg sm:text-xl bg-slate-800 text-white dark:bg-emerald-500 dark:text-slate-900 shrink-0">
              MS
            </div>
            <div class="min-w-0">
              <h3 class="font-mono text-lg sm:text-xl mb-2">{post.data.author}</h3>
              <p class="text-slate-600 dark:text-slate-300 mb-4">
                {post.data.authorBio}
              </p>
              <div class="flex flex-wrap gap-x-4 gap-y-2">
                <a
                  href="/"
                  class="font-mono text-sm hover:text-slate-900 dark:hover:text-emerald-400 transition-colors"
                >
                  Portfolio →
                </a>
                <a
                  href="https://github.com/Salah-XD"
                  target="_blank"
                  rel="noreferrer"
                  class="font-mono text-sm hover:text-slate-900 dark:hover:text-emerald-400 transition-colors"
                >
                  GitHub →
                </a>
              </div>
            </div>
          </div>
        </div>

        {giscusReady ? (
          <Comments
            client:load
            repo={giscusRepo}
            repoId={giscusRepoId}
            category={giscusCategory}
            categoryId={giscusCategoryId}
          />
        ) : (
          <section class="mt-16 p-6 border rounded-lg border-dashed border-slate-300 dark:border-slate-700 text-center">
            <p class="font-mono text-sm text-slate-500 dark:text-slate-400">
              Comments will appear here once the Giscus environment variables are configured.
            </p>
          </section>
        )}
      </article>

      <TableOfContents client:load headings={headings} />
    </main>
  </div>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify([
      {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: post.data.title,
        description,
        datePublished: post.data.date,
        dateModified: post.data.date,
        author: {
          '@type': 'Person',
          '@id': 'https://salahxd.dev/#person',
          name: post.data.author,
          url: 'https://salahxd.dev/',
        },
        publisher: { '@id': 'https://salahxd.dev/#person' },
        keywords: post.data.tags.join(', '),
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
        image: new URL(ogImage, Astro.site ?? 'https://salahxd.dev').toString(),
        isPartOf: { '@id': 'https://salahxd.dev/#website' },
      },
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://salahxd.dev/' },
          { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://salahxd.dev/blog/' },
          { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical },
        ],
      },
    ])}
  />
</Layout>
