---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { ArrowLeft, Calendar, Clock, Tag } from 'lucide-react';
import ThemeToggle from '../../components/ThemeToggle';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const ogImage = `/og/${post.id}.png`;
const description =
  post.data.excerpt ||
  `${post.data.title} — by ${post.data.author}`;
---

<Layout
  title={`${post.data.title} | MD Salah`}
  description={description}
  ogImage={ogImage}
  ogType="article"
  publishedTime={post.data.date}
  author={post.data.author}
  tags={post.data.tags}
>
  <div class="min-h-screen transition-colors duration-300">
    <header class="border-b border-slate-200 dark:border-slate-700">
      <div class="max-w-4xl mx-auto px-4 py-6 flex items-center justify-between gap-3">
        <a
          href="/blog"
          class="flex items-center space-x-2 font-mono text-sm hover:text-slate-700 dark:hover:text-emerald-400 transition-colors"
        >
          <ArrowLeft className="w-4 h-4" />
          <span>Back to Blog</span>
        </a>
        <ThemeToggle client:load />
      </div>
    </header>

    <article class="py-12 px-4">
      <div class="max-w-4xl mx-auto">
        <header class="mb-12">
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-6">
            <div class="flex items-center space-x-2">
              <Calendar className="w-4 h-4 text-slate-500 dark:text-emerald-400" />
              <time class="font-mono text-sm text-slate-500 dark:text-emerald-400">
                {post.data.date}
              </time>
            </div>

            {post.data.readTime && (
              <div class="flex items-center space-x-2">
                <Clock className="w-4 h-4 text-slate-500 dark:text-slate-400" />
                <span class="font-mono text-sm text-slate-500 dark:text-slate-400">
                  {post.data.readTime}
                </span>
              </div>
            )}

            <span class="font-mono text-xs px-2 py-1 rounded bg-slate-100 text-slate-700 dark:bg-slate-700 dark:text-slate-300">
              {post.data.category}
            </span>
          </div>

          <h1 class="font-mono text-2xl sm:text-3xl md:text-4xl lg:text-5xl mb-6 leading-tight break-words">
            {post.data.title}
          </h1>

          {post.data.tags.length > 0 && (
            <div class="flex items-center space-x-2">
              <Tag className="w-4 h-4 text-slate-500 dark:text-slate-400 shrink-0" />
              <div class="flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <span class="font-mono text-xs px-2 py-1 rounded bg-slate-100 text-slate-700 dark:bg-slate-700 dark:text-slate-300">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          )}
        </header>

        <div
          class="prose prose-slate dark:prose-invert max-w-none prose-a:text-slate-700 dark:prose-a:text-emerald-400 hover:prose-a:text-slate-900 dark:hover:prose-a:text-emerald-300"
          data-pagefind-body
        >
          <Content />
        </div>

        <div class="mt-16 p-6 border rounded-lg border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/50">
          <div class="flex items-start gap-4">
            <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full flex items-center justify-center font-mono text-lg sm:text-xl bg-slate-800 text-white dark:bg-emerald-500 dark:text-slate-900 shrink-0">
              MS
            </div>
            <div class="min-w-0">
              <h3 class="font-mono text-lg sm:text-xl mb-2">{post.data.author}</h3>
              <p class="text-slate-600 dark:text-slate-300 mb-4">
                {post.data.authorBio}
              </p>
              <div class="flex flex-wrap gap-x-4 gap-y-2">
                <a
                  href="/"
                  class="font-mono text-sm hover:text-slate-900 dark:hover:text-emerald-400 transition-colors"
                >
                  Portfolio →
                </a>
                <a
                  href="https://github.com/Salah-XD"
                  target="_blank"
                  rel="noreferrer"
                  class="font-mono text-sm hover:text-slate-900 dark:hover:text-emerald-400 transition-colors"
                >
                  GitHub →
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </article>
  </div>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: post.data.title,
      description,
      datePublished: post.data.date,
      author: { '@type': 'Person', name: post.data.author },
      keywords: post.data.tags.join(', '),
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': new URL(`/blog/${post.id}`, Astro.site ?? 'https://salahxd.vercel.app').toString(),
      },
      image: new URL(ogImage, Astro.site ?? 'https://salahxd.vercel.app').toString(),
    })}
  />
</Layout>
