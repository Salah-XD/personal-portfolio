---
import '../index.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import BootSequence from '../components/BootSequence';
import Konami from '../components/Konami';
import CrtOverlay from '../components/CrtOverlay';
import KeyboardHelp from '../components/KeyboardHelp';
import GlobalShortcuts from '../components/GlobalShortcuts';
import { author } from '../config/portfolio';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  canonical?: string;
  publishedTime?: string;
  author?: string;
  tags?: string[];
  noindex?: boolean;
}

const {
  title,
  description = 'Mohd Salahudeen — software engineer & founder of QSat & ShineUp. I write the code and run the companies.',
  ogImage,
  ogType = 'website',
  canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://salahxd.dev').toString(),
  publishedTime,
  author = 'Mohd Salahudeen',
  tags = [],
  noindex = false,
} = Astro.props;

const siteName = 'Mohd Salahudeen';
const twitterHandle = '@thisis_salah';
const resolvedOgImage = ogImage
  ? new URL(ogImage, Astro.site ?? 'https://salahxd.dev').toString()
  : new URL('/og-default.png', Astro.site ?? 'https://salahxd.dev').toString();

// Site-wide structured data. The Person + WebSite entities (with sameAs links)
// tell Google/Bing that this site *is* the entity "Mohd Salahudeen" / "salahxd",
// which is the core signal for ranking on the name and for rich results.
const siteUrl = (Astro.site ?? new URL('https://salahxd.dev')).toString();
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteUrl}#website`,
    url: siteUrl,
    name: 'Mohd Salahudeen',
    alternateName: ['salahxd', 'Salah'],
    inLanguage: 'en',
    publisher: { '@id': `${siteUrl}#person` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${siteUrl}#person`,
    name: 'Mohd Salahudeen',
    alternateName: ['salahxd', 'Salah', 'MD Salah'],
    url: siteUrl,
    image: `${siteUrl}og-default.png`,
    jobTitle: 'Software Engineer & Founder',
    description:
      'Software engineer and founder of QSat and ShineUp — I build software and the companies behind it.',
    worksFor: [
      {
        '@type': 'Organization',
        name: 'QSat',
        url: 'https://qsat.vercel.app',
        sameAs: ['https://www.instagram.com/qsat.diy/'],
      },
      {
        '@type': 'Organization',
        name: 'ShineUp',
        url: 'https://shineup.digital',
        sameAs: [
          'https://www.instagram.com/shineup.digital/',
          'https://www.linkedin.com/company/shineup-digital/',
        ],
      },
    ],
    knowsAbout: [
      'Software Engineering',
      'Web Development',
      'GIS',
      'Geospatial',
      'CubeSats',
      'Space Education',
      'Startups',
    ],
    sameAs: [author.github, author.linkedin, 'https://x.com/thisis_salah'],
  },
];

const sourceComment = [
  '<!--',
  '   _   _      _ _         _                _',
  '  | | | | ___| | | ___   | |__   __ _  ___| | _____ _ __',
  "  | |_| |/ _ \\ | |/ _ \\  | '_ \\ / _` |/ __| |/ / _ \\ '__|",
  '  |  _  |  __/ | | (_) | | | | | (_| | (__|   <  __/ |',
  '  |_| |_|\\___|_|_|\\___/  |_| |_|\\__,_|\\___|_|\\_\\___|_|',
  '',
  '  source:    https://github.com/Salah-XD/personal-portfolio',
  "  shortcuts: press '?' for the help dialog · ⌘K opens the palette",
  '  built:     Astro 5 · React 18 · Tailwind 3 · GSAP · Lenis · Pagefind',
  '  by:        Mohd Salahudeen, with intention',
  '-->',
].join('\n');
---

<!DOCTYPE html>
<html lang="en" class="antialiased">
  <head>
    <Fragment set:html={sourceComment} />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} blog`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0f172a" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteName} — ${title}`} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && <meta property="article:author" content={author} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={twitterHandle} />
    <meta name="twitter:creator" content={twitterHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = stored === 'light' || stored === 'dark' ? stored : prefersDark ? 'dark' : 'dark';
          if (theme === 'dark') document.documentElement.classList.add('dark');
          else document.documentElement.classList.remove('dark');
        } catch (e) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="bg-slate-50 text-slate-900 dark:bg-slate-900 dark:text-slate-100">
    <slot />
    <BootSequence client:load />
    <Konami client:load />
    <CrtOverlay client:load />
    <KeyboardHelp client:load />
    <GlobalShortcuts client:load />
    <Analytics />
    <SpeedInsights />

    <script>
      // Inject copy buttons into rendered code blocks (Shiki output uses <pre><code>).
      const enhancePre = () => {
        document.querySelectorAll<HTMLPreElement>('article pre:not([data-copy-enhanced])').forEach((pre) => {
          pre.dataset.copyEnhanced = 'true';
          pre.classList.add('group', 'relative');
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.setAttribute('aria-label', 'Copy code');
          btn.className =
            'absolute top-2 right-2 px-2 py-1 text-xs font-mono rounded border border-slate-700 bg-slate-800/80 text-slate-200 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 transition-opacity';
          btn.textContent = 'copy';
          btn.addEventListener('click', async () => {
            const code = pre.querySelector('code')?.innerText ?? pre.innerText;
            try {
              await navigator.clipboard.writeText(code);
              btn.textContent = 'copied';
              setTimeout(() => (btn.textContent = 'copy'), 1200);
            } catch {
              btn.textContent = 'failed';
              setTimeout(() => (btn.textContent = 'copy'), 1200);
            }
          });
          pre.appendChild(btn);
        });
      };
      enhancePre();
      document.addEventListener('astro:page-load', enhancePre);
    </script>

    <script>
      // Hide nav on scroll down, show on scroll up.
      // Re-queries on each tick so islands hydrated after init still get tracked.
      let lastY = window.scrollY;
      let ticking = false;
      const applyNavScroll = () => {
        const y = window.scrollY;
        const delta = y - lastY;
        if (Math.abs(delta) < 6) {
          ticking = false;
          return;
        }
        const hide = y > 80 && delta > 0;
        document
          .querySelectorAll<HTMLElement>('[data-nav-sticky]')
          .forEach((n) => n.classList.toggle('-translate-y-full', hide));
        lastY = y;
        ticking = false;
      };
      window.addEventListener(
        'scroll',
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(applyNavScroll);
        },
        { passive: true }
      );
    </script>
  </body>
</html>
