# ─────────────────────────────────────────────────────────────────────────────
# Environment variables for the portfolio.
# Copy to `.env` for local dev, and set the same keys in Vercel → Project →
# Settings → Environment Variables for production.
#
# EVERY feature below degrades gracefully: if a group is missing, that feature
# shows a "not configured" placeholder and the rest of the site still builds.
# ─────────────────────────────────────────────────────────────────────────────

# --- Likes + view counters (Upstash Redis) -----------------------------------
# Provision "Upstash" on the Vercel Marketplace and these are auto-set.
# The UPSTASH_REDIS_REST_* aliases also work (redis.ts checks both).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Blog comments (Giscus) --------------------------------------------------
# Enable Discussions on the GitHub repo, then generate these at https://giscus.app
# PUBLIC_ prefix is required — these are read in the browser.
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=
PUBLIC_GISCUS_CATEGORY_ID=

# --- Newsletter signup (Buttondown) ------------------------------------------
# https://buttondown.com → Settings → API & Integrations.
# Without it, /api/subscribe returns 503 and the form shows a "not configured" note.
# Tip: enable Buttondown's RSS-to-email so every new post auto-broadcasts.
BUTTONDOWN_API_KEY=

# --- Keystatic admin OAuth (production /keystatic) ---------------------------
# 32+ random characters. Used to sign the Keystatic admin session.
KEYSTATIC_SECRET=
